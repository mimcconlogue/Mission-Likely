[sub_resource type="GDScript" id="GDScript_vef74"]
script/source = "extends Node2D

@onready var player: Node2D = $\"../LitViewport/player\"


var center = Vector2()
var damping = 12.0

func _physics_process(delta):
	apply_camera(delta)

func apply_camera(delta):
	var mpos = get_global_mouse_position()
	var ppos = player.get_node(\"Legs\").global_position
	center = Vector2((ppos.x + mpos.x) / 2, (ppos.y + mpos.y) / 2)
	global_position = lerp(global_position, center, delta * damping)
"

