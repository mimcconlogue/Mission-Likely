[sub_resource type="GDScript" id="GDScript_div1a"]
script/source = "extends Node2D
var prepared = false
var type = \"gun\"
@onready var pistol_not_ready: Node2D = $PistolNotReady
@onready var pistol_ready: Node2D = $PistolReady
var open = false
var current_animation_is_idle = true
@onready var current_child = pistol_not_ready
signal animation_over
func _ready() -> void: 
	check_prepared()
func check_prepared():
	if prepared == true :
		pistol_ready.show()
		pistol_not_ready.hide()
		pistol_ready.set_process(true)
		pistol_not_ready.set_process(false)
		current_child = pistol_ready
	else:
		pistol_ready.hide()
		pistol_not_ready.show()
		pistol_ready.set_process(false)
		pistol_not_ready.set_process(true)
		current_child = pistol_not_ready
	current_child.get_child(0).get_child(0).play(\"animations\" + \"/\" + \"idle\")
func check_animation():
	if current_animation_is_idle == true:
		current_child.get_child(0).get_child(0).play(\"idle\")
	else:
		pass
func check_idle():
	if get_child(0).idle == true :
		current_animation_is_idle = true
	if get_child(1).idle == true :
		current_animation_is_idle = true


func _on_fists_not_ready_animation_over() -> void:
	animation_over.emit()
"

[node name="weapon" type="Node2D" unique_id=1906809424]
