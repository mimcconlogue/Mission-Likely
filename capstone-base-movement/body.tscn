[sub_resource type="GDScript" id="GDScript_tg1dk"]
script/source = "extends Node2D
#WAIT, make sure to keep all the code not weapon specific, refer to all the animations by the name of the input.
var prep = false
@onready var player: Node2D = $\"../..\"
@onready var camera_control: Node2D = $\"../../camera control\"
@onready var legs: CharacterBody2D = $\"..\"
@onready var fists: AnimatedSprite2D = $fists
@onready var knife: AnimatedSprite2D = $knife
@onready var axe: AnimatedSprite2D = $axe
@onready var revolver: AnimatedSprite2D = $revolver
@onready var repeater: AnimatedSprite2D = $repeater
@onready var shotgun: AnimatedSprite2D = $shotgun
@onready var fist_timer: Timer = $FistTimer
@onready var fist_hit_shape: CollisionShape2D = $Area2D/FistHitShape
#list of sprites, if you add one make sure to add it at the end, the order is important.
var items
var current_item = fists
var current_animation : String
var animation_playing = false
@export var body_rotation = 0.0
func _ready() -> void:
	items = get_children()
	current_item = fists
	isolate_item()
	fist_hit_shape.set_disabled(true)
func _input(event):
	if event.is_action_pressed(\"move_down\"):
		if event.is_action_pressed(\"move_up\"):
			if event.is_action_pressed(\"move_left\"):
				if event.is_action_pressed(\"move_right\"):
					pass
	else:
		if prep == true :
			current_animation = \"ready\"
		else:
			current_animation = \"not_ready\"
		if event.is_action_pressed(\"ready\"):
			if prep == true :
				prep = false
			elif prep == false:
				prep = true
		if event.is_action_pressed(\"slot1\"):
			current_item = items[0]
			isolate_item()
			current_item.show()
		if event.is_action_pressed(\"slot2\"):
			current_item = items[1]
			isolate_item()
			current_item.show()
		if event.is_action_pressed(\"emptyhands\"):
			current_item = items[2]
			isolate_item()
			current_item.show()
		if event.is_action_pressed(\"attack1\"):
			if prep == true:
				current_animation = \"attack1\"
				fist_hit_shape.set_disabled(false)
				fist_timer.start()
			else:
				current_animation = \"attack_nr1\"
		check_anim_state()
		
	
	

func check_anim_state():
	animation_playing=true
	current_item.play(current_animation)

func _process(_delta):
	
	look_at(camera_control.center)
	body_rotation = rotation
	
func isolate_item():
	items[0].hide()
	items[1].hide()
	items[2].hide()
	current_item.show()


func _on_fists_animation_finished() -> void:
	animation_playing = false


func _on_fist_timer_timeout() -> void:
	fist_hit_shape.set_disabled(true)
"

